# Copy this file to `.env` ON THE SERVER and fill in the values. Never put the real .env in Git.

APP_NAME="Agarwal Brothers"
# production = the real site (Google may index it). staging = a demo for the client (hidden from Google).
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The exact address of the site, with https (first the temporary Hostinger link, later https://agarwalbrother.com)
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Database (create it in hPanel -> Databases -> MySQL Databases; Hostinger adds a prefix like u123456789_)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_agarwal
DB_USERNAME=u123456789_agarwal
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cookies only over https (the site must run on https, see public/.htaccess)
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
# Half-finished admin uploads wait in a private folder, never in the public /storage area
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

# Mail: create a mailbox in hPanel -> Emails, then use its SMTP details
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Office address that receives enquiries / contact messages / job applications
CONTACT_INBOX=office@agarwalbrothers.com
# Address shown on the privacy page for data requests (falls back to CONTACT_INBOX)
PRIVACY_EMAIL=office@agarwalbrothers.com

# Google Analytics 4 id (optional; only loads after the visitor accepts cookies)
ANALYTICS_ID=
